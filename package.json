  "private": true,
  "description": "Pre-launch security and cost-risk scanner for vibe-coded web apps",
  "license": "MIT",
  "author": "xploit007",
  "homepage": "https://github.com/xploit007/preflight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xploit007/preflight.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "agent-skills",
